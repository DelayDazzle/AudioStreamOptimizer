<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AudioStreamOptimizer</AssemblyName>
    <RootNamespace>DelayDazzle.AudioStreamOptimizer</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>DelayDazzle</Authors>
  </PropertyGroup>
  <ItemGroup>
    <!-- 引用 SMAPI 核心库 -->
    <PackageReference Include="StardewModdingAPI" Version="4.3.2" />
    <!-- 引用星露谷游戏数据接口，用于 AudioCueData -->
    <PackageReference Include="StardewValley.GameData" Version="1.6.0" />
  </ItemGroup>
</Project>
