<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AudioStreamOptimizer</AssemblyName>
    <RootNamespace>DelayDazzle.AudioStreamOptimizer</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>DelayDazzle</Authors>
    <!-- 关键配置：告诉构建工具在云端环境跳过查找游戏目录 -->
    <EnableModBuildConfig>true</EnableModBuildConfig>
    <GamePath></GamePath>
  </PropertyGroup>
  <ItemGroup>
    <!-- 引用官方模组构建配置包，版本用最新的 4.4.0 -->
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>
</Project>
